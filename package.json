{
  "name": "ai-pdf-chatbot-langchain",
  "description": "AI PDF chatbot template based on the book Learning LangChain (O'Reilly)",
  "private": true,
  "packageManager": "npm@10.8.2",
  "version": "0.0.1",
  "author": "Mayo Oshin",
  "license": "MIT",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run turbo:command build",
    "turbo:command": "npx turbo",
    "lint": "npm run turbo:command lint",
    "lint:fix": "npm run turbo:command lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "latest"
  }
}
